@model IEnumerable<tournamentdomain.Model.Captain>

@{
    ViewData["Title"] = "Капітани";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Капітани</h1>
    <div class="d-flex">
        <form class="d-flex me-2" method="get" asp-action="Index">
            <input class="form-control form-control-sm" type="search" name="q" placeholder="Пошук за іменем або командою" aria-label="Search" />
            <button class="btn btn-sm btn-outline-secondary ms-2" type="submit">Пошук</button>
        </form>
        <a class="btn btn-primary btn-sm" asp-action="Create">Додати капітана</a>
    </div>
</div>

@if (!Model?.Any() ?? true)
{
    <div class="alert alert-info">Список капітанів порожній.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        @foreach (var item in Model)
        {
            var nickname = item.NicknameNavigation?.Nickname ?? "-";
            var team = item.TeamNameNavigation?.Name ?? "-";
            var initial = !string.IsNullOrEmpty(nickname) ? nickname.Substring(0, 1).ToUpper() : "?";
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;font-weight:600;">@initial</div>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="card-title mb-1">@nickname</h5>
                        <p class="card-text text-muted small mb-2">Команда: <strong>@team</strong></p>

                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Nickname">Перегляд</a>
                            <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@item.Nickname">Редагувати</a>
                            <form asp-action="Delete" asp-route-id="@item.Nickname" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити цього капітана?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
}

