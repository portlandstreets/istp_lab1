@model IEnumerable<tournamentdomain.Model.Match>

    @{
    ViewData["Title"] = "Матчі";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Матчі</h1>
        <div class="d-flex">
            <form class="d-flex me-2" method="get" asp-action="Index">
                <input class="form-control form-control-sm" type="search" name="q" placeholder="Пошук за стадією або турніром" aria-label="Search" />
                <button class="btn btn-sm btn-outline-secondary ms-2" type="submit">Пошук</button>
            </form>
            <a class="btn btn-primary btn-sm" asp-action="Create">Додати матч</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Export">Експорт в Excel</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="ExportDoc">Експорт в DOC</a>
            <a class="btn btn-primary mb-3" type="submit" asp-area="" asp-controller="Matches" asp-action="Import">Завантажити з файлу</a> <!--[cite: 1] -->
        </div>
    </div>

    @if (!Model?.Any() ?? true)
    {
    <div class="alert alert-info">Список матчів порожній.</div>
    }
    else
    {
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        @foreach (var item in Model)
        {
        var tournamentName = item.TournamentNameNavigation?.Name ?? "Не вказано";
        var winnerTeam = item.WinnerTeamNavigation?.Name ?? "Нічия/В процесі";
        // Використовуємо першу літеру стадії для іконки, як у капітанів
        var initial = !string.IsNullOrEmpty(item.Stage) ? item.Stage.Substring(0, 1).ToUpper() : "M";

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex">
                    <div class="flex-shrink-0 me-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;font-weight:600;">@initial</div>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="card-title mb-1">@item.Stage</h5>
                        <p class="card-text text-muted small mb-1">Турнір: <strong>@tournamentName</strong></p>
                        <p class="card-text text-muted small mb-1">Дата: @item.MatchDate?.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="card-text text-muted small mb-2">Переможець: <span class="badge bg-success text-white">@winnerTeam</span></p>

                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Перегляд</a>
                            <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@item.Id">Редагувати</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити цей матч?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    }
