@model IEnumerable<tournamentdomain.Model.Tournament>

@{
    ViewData["Title"] = "Турніри";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Турніри</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Charts" asp-action="PrizePools">Діаграма призових пулів</a>
        @* Додавати нові турніри та експорт доступні тільки адмін *@
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">Створити новий</a>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Export">Експорт в Excel</a>
        }
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>@Html.DisplayNameFor(model => model.StartDate)</th>
            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
            <th>@Html.DisplayNameFor(model => model.PrizePool)</th>
            <th>@Html.DisplayNameFor(model => model.OrganizerNameNavigation)</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Location)</td>
            <td>@item.StartDate?.ToString("dd.MM.yyyy")</td>
            <td>@item.EndDate?.ToString("dd.MM.yyyy")</td>
            <td>@Html.DisplayFor(modelItem => item.PrizePool)</td>
            <td>@Html.DisplayFor(modelItem => item.OrganizerNameNavigation.Name)</td>
            <td>
                @* Редагувати може тільки адмін *@
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Name">Редагувати</a> @:|
                }

                @* Переглядати деталі можуть усі *@
                <a asp-action="Details" asp-route-id="@item.Name">Деталі</a>

                @* Видаляти може тільки адмін *@
                @if (User.IsInRole("Admin"))
                {
                    @:| <a asp-action="Delete" asp-route-id="@item.Name">Видалити</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>