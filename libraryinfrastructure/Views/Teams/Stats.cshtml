@{
    ViewData["Title"] = "Статистика команд";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Статистика команд</h1>
    <div>
        <button id="btnRefresh" class="btn btn-primary btn-sm">Оновити статистику</button>
    </div>
</div>

<div id="chart_div" style="width: 100%; height: 500px;"></div>

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script>
        google.charts.load('current', { 'packages': ['corechart'] });
        google.charts.setOnLoadCallback(drawChart);

        async function fetchData() {
            const resp = await fetch('@Url.Action("StatsData", "Teams")');
            const data = await resp.json();
            return data;
        }

        async function drawChart() {
            const raw = await fetchData();
            // raw is like [ ['Team','Points'], ['A',10], ... ]
            const data = google.visualization.arrayToDataTable(raw);

            const options = {
                title: 'Розподіл очок між командами',
                pieHole: 0.4,
            };

            const chart = new google.visualization.PieChart(document.getElementById('chart_div'));
            chart.draw(data, options);
        }

        document.getElementById('btnRefresh').addEventListener('click', drawChart);
    </script>
}
